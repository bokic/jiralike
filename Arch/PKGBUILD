# Maintainer: Boris Barbulovski <bbarbulovski@gmail.com>
pkgname=("jiralike" "jiralike-config-nginx" "jiralike-fe")
arch=('x86_64' 'i686')
pkgver=0.1
pkgrel=1
url="https://github.com/bokic/cpp_ws_backend"
license=('LGPL3')
makedepends=('cmake' 'ninja' 'gcc' 'fcgi' 'json-c' 'sqlite' 'nodejs' 'npm')

build() {
  cd "${srcdir}/../../../.."
  ./build.sh
  cd "${srcdir}/../../web"
  npm install
  npm run build
}

package_jiralike() {
  depends=('fcgi' 'json-c' 'sqlite')
  pkgdesc="Jira-like project management FastCGI backend written in C++23 with automatic SQLite migrations"
  install -Dm755 "${srcdir}/../../jiralike" "$pkgdir/opt/jiralike/jiralike"
  install -Dm644 "${srcdir}/../../jiralike.service" "$pkgdir/usr/lib/systemd/system/jiralike.service"
  install -Dm644 "${srcdir}/../jiralike.sysusers" "$pkgdir/usr/lib/sysusers.d/jiralike.conf"
  install -Dm644 "${srcdir}/../jiralike.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/jiralike.conf"
  mkdir -p "$pkgdir/opt/jiralike/db/migrations"
  cp -r "${srcdir}/../../db/migrations/"*.sql "$pkgdir/opt/jiralike/db/migrations/"
}

package_jiralike-config-nginx() {
  arch=('any')
  depends=('nginx' 'jiralike-fe')
  pkgdesc="Nginx configuration for jiralike Angular SPA and FastCGI backend"
  install -d "$pkgdir/etc/nginx/sites-available"
  sed 's|/opt/jiralike-fe|/srv/http/jiralike|g' \
    "${srcdir}/../../nginx/000-jiralike.com" \
    > "$pkgdir/etc/nginx/sites-available/000-jiralike.com"
  chmod 644 "$pkgdir/etc/nginx/sites-available/000-jiralike.com"
}

package_jiralike-fe() {
  arch=('any')
  depends=('jiralike')
  pkgdesc="jiralike Angular Single-Page Application frontend"
  local destdir="$pkgdir/srv/http/jiralike"
  mkdir -p "$destdir"
  cp -r "${srcdir}/../../web/dist/web/browser/"* "$destdir/"
  chown -R http:http "$destdir"
  find "$destdir" -type d -exec chmod 555 {} +
  find "$destdir" -type f -exec chmod 444 {} +
}
