[Unit]
Description=JiraLike web-service FastCGI backend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/jiralike
ExecStart=/opt/jiralike/jiralike -n 127.0.0.1:9002 -w 4 -d /var/lib/jiralike/db/jiralike.db -u /var/lib/jiralike/blobs
ExecStop=/bin/kill -SIGUSR1 $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target
